# Copy to .env and fill in. Never commit real secrets.

# --- Database (used by infra/docker-compose.yml and the API) ---
POSTGRES_USER=orchestrai
POSTGRES_PASSWORD=orchestrai
POSTGRES_DB=orchestrai
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://orchestrai:orchestrai@localhost:5432/orchestrai

# --- LLM ---
GEMINI_API_KEY=
# Set to a current Gemini model id (not the 2.5 family).
GEMINI_MODEL=
# live | record | fixture  (tests and demo use fixture)
LLM_MODE=fixture

# --- API ---
CORS_ORIGINS=http://localhost:5173
SIM_SEED=42

# --- Web ---
VITE_API_URL=http://localhost:8000
# true serves mock data from the browser until the API endpoints exist (Step 18).
VITE_USE_MOCKS=true
