# Copy to .env and fill in. Never commit real secrets.

# --- Database (used by infra/docker-compose.yml and the API) ---
POSTGRES_USER=orchestrai
POSTGRES_PASSWORD=orchestrai
POSTGRES_DB=orchestrai
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://orchestrai:orchestrai@localhost:5432/orchestrai

# --- LLM ---
GEMINI_API_KEY=
# Current Gemini model id (never the 2.5 family). Default per ai.google.dev models page, Nov 2026:
# "For any new projects, use our latest models: 3.5 Flash-Lite or 3.8 Flash."
GEMINI_MODEL=gemini-3.8-flash
# live | record | fixture  (tests and demo use fixture; fixture needs no API key)
LLM_MODE=fixture
# Per-request timeout for Gemini calls, in seconds.
LLM_TIMEOUT_SECONDS=60

# --- API ---
CORS_ORIGINS=http://localhost:5173
SIM_SEED=42

# --- Web ---
VITE_API_URL=http://localhost:8000
# true adds browser mocks for endpoints the API does not have yet.
VITE_USE_MOCKS=false
